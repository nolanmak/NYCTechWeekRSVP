{
  "name": "nyctechweekrsvp",
  "version": "0.1.0",
  "description": "Auto-RSVP to NYC Tech Week events hosted on Partiful. Harvests events from tech-week.com, matches your saved profile against each event's questionnaire, and submits RSVPs in bulk.",
  "main": "rsvp.js",
  "scripts": {
    "harvest": "node harvest.js",
    "dry": "node rsvp.js",
    "live": "node rsvp.js --live",
    "live:guess": "node rsvp.js --live --guess",
    "retry": "node rsvp.js --live --retry-skipped --guess"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "author": "nolanmak",
  "repository": {
    "type": "git",
    "url": "https://github.com/nolanmak/NYCTechWeekRSVP.git"
  },
  "keywords": [
    "partiful",
    "tech-week",
    "rsvp",
    "automation",
    "nyc"
  ]
}
